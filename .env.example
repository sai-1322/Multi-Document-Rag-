# Copy to .env and fill in. NEVER commit .env.

# --- required ---
OPENAI_API_KEY=sk-...

# --- API protection (leave empty ONLY for local dev) ---
API_KEY=change-me-to-a-long-random-string

# --- models ---
LLM_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=http://localhost:11434/v1     # any OpenAI-compatible server (Ollama, vLLM...)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# JUDGE_MODEL=gpt-4o                            # use a different model to judge than to answer

# --- retrieval tuning ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
CANDIDATE_K=20
FINAL_K=4
BM25_WEIGHT=0.4
DENSE_WEIGHT=0.6
# MIN_RERANK_SCORE=-3.0                         # drop chunks the reranker scores below this

# --- limits / cache ---
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_INGEST=5/minute
MAX_UPLOAD_MB=25
CACHE_TTL_SECONDS=3600
# ALLOW_PRIVATE_URLS=1                          # dev only: lets /ingest fetch localhost/intranet URLs
